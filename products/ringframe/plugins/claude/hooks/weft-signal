#!/bin/sh
# Every hook of this harness runs this: `weft-signal [--reply <json>] <harness id> <hook>`.
# Weft's `weft signal` reads the payload, answers the hook and tells weftd what
# the hook means (Weft ADR-0030). Installing RingFrame installs `weft`; if it is
# somehow missing, answer the hook alone and change nothing.
if command -v weft >/dev/null 2>&1; then
  exec weft signal "$@"
fi
if [ "$1" = --reply ]; then
  printf '%s\n' "$2"
fi
exit 0
