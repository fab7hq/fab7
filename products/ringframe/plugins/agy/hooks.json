{
  "rf-state": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "./hooks/rf-hook.sh sessions turn --from-hook --host agy --event working"
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "./hooks/rf-hook.sh sessions turn --from-hook --host agy --event turn_ended"
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/rf-hook.sh --allow sessions turn --from-hook --host agy --event waiting"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "ask_question",
        "hooks": [
          {
            "type": "command",
            "command": "./hooks/rf-hook.sh sessions turn --from-hook --host agy --event working"
          }
        ]
      }
    ]
  }
}
