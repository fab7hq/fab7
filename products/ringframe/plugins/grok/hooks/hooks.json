{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${GROK_PLUGIN_ROOT}/hooks/rf-hook.sh sessions turn --from-hook --host grok --event ready"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${GROK_PLUGIN_ROOT}/hooks/capture-prompt.sh"
          },
          {
            "type": "command",
            "command": "${GROK_PLUGIN_ROOT}/hooks/rf-hook.sh sessions turn --from-hook --host grok --event working"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "ask_user_question",
        "hooks": [
          {
            "type": "command",
            "command": "${GROK_PLUGIN_ROOT}/hooks/rf-hook.sh sessions turn --from-hook --host grok --event waiting"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "enter_plan_mode",
        "hooks": [
          {
            "type": "command",
            "command": "${GROK_PLUGIN_ROOT}/hooks/rf-hook.sh ask delivery --from-hook --host grok"
          }
        ]
      },
      {
        "matcher": "run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "${GROK_PLUGIN_ROOT}/hooks/rf-hook.sh fact --from-hook --host grok --outcome succeeded"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${GROK_PLUGIN_ROOT}/hooks/rf-hook.sh sessions turn --from-hook --host grok --event working"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "run_terminal_command",
        "hooks": [
          {
            "type": "command",
            "command": "${GROK_PLUGIN_ROOT}/hooks/rf-hook.sh fact --from-hook --host grok --outcome failed"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "${GROK_PLUGIN_ROOT}/hooks/rf-hook.sh sessions turn --from-hook --host grok --event working"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${GROK_PLUGIN_ROOT}/hooks/rf-hook.sh sessions turn --from-hook --host grok --event turn_ended"
          }
        ]
      }
    ]
  }
}
