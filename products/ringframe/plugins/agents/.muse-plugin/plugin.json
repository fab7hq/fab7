{
  "schemaVersion": 1,
  "name": "rf",
  "displayName": "RingFrame",
  "version": "0.2.0",
  "description": "RingFrame: turn one explicit intent into a confirmed native prompt, evaluate the exact result, record the decision",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "rf-ask",
        "path": "muse/skills/rf-ask/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "rf-eval",
        "path": "muse/skills/rf-eval/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "rf-seal",
        "path": "muse/skills/rf-seal/SKILL.md",
        "enabledDefault": true
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "session-start",
        "event": "SessionStart",
        "command": [
          "sh",
          "muse/hooks/session-start.sh"
        ],
        "timeoutMs": 10000
      },
      {
        "id": "user-prompt-submit",
        "event": "UserPromptSubmit",
        "command": [
          "sh",
          "muse/hooks/user-prompt-submit.sh"
        ],
        "timeoutMs": 10000
      },
      {
        "id": "pre-tool-use-request-user-input",
        "event": "PreToolUse",
        "command": [
          "sh",
          "muse/hooks/pre-tool-use-request-user-input.sh"
        ],
        "timeoutMs": 10000
      },
      {
        "id": "permission-request",
        "event": "PermissionRequest",
        "command": [
          "sh",
          "muse/hooks/permission-request.sh"
        ],
        "timeoutMs": 10000
      },
      {
        "id": "post-tool-use",
        "event": "PostToolUse",
        "command": [
          "sh",
          "muse/hooks/post-tool-use.sh"
        ],
        "timeoutMs": 10000
      },
      {
        "id": "stop",
        "event": "Stop",
        "command": [
          "sh",
          "muse/hooks/stop.sh"
        ],
        "timeoutMs": 10000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
