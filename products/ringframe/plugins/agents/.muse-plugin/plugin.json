{
  "schemaVersion": 1,
  "name": "rf",
  "displayName": "RingFrame",
  "version": "0.2.0",
  "description": "RingFrame: turn one explicit intent into a confirmed native prompt, evaluate the exact result, record the decision",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "rf-ask",
        "path": "muse/skills/rf-ask/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "rf-eval",
        "path": "muse/skills/rf-eval/SKILL.md",
        "enabledDefault": true
      },
      {
        "id": "rf-seal",
        "path": "muse/skills/rf-seal/SKILL.md",
        "enabledDefault": true
      }
    ],
    "commands": [],
    "hooks": [
      {
        "id": "SessionStart",
        "event": "SessionStart",
        "command": [
          "sh",
          "muse/hooks/weft-signal",
          "muse",
          "SessionStart"
        ],
        "timeoutMs": 10000
      },
      {
        "id": "UserPromptSubmit",
        "event": "UserPromptSubmit",
        "command": [
          "sh",
          "muse/hooks/weft-signal",
          "muse",
          "UserPromptSubmit"
        ],
        "timeoutMs": 10000
      },
      {
        "id": "PreToolUse-request_user_input",
        "event": "PreToolUse",
        "command": [
          "sh",
          "muse/hooks/weft-signal",
          "muse",
          "PreToolUse"
        ],
        "timeoutMs": 10000
      },
      {
        "id": "PermissionRequest",
        "event": "PermissionRequest",
        "command": [
          "sh",
          "muse/hooks/weft-signal",
          "muse",
          "PermissionRequest"
        ],
        "timeoutMs": 10000
      },
      {
        "id": "PostToolUse",
        "event": "PostToolUse",
        "command": [
          "sh",
          "muse/hooks/weft-signal",
          "muse",
          "PostToolUse"
        ],
        "timeoutMs": 10000
      },
      {
        "id": "Stop",
        "event": "Stop",
        "command": [
          "sh",
          "muse/hooks/weft-signal",
          "muse",
          "Stop"
        ],
        "timeoutMs": 10000
      }
    ],
    "mcpServers": [],
    "reminders": []
  }
}
