{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/hooks/capture-prompt.sh"
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/hooks/record-turn.sh working"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "request_user_input",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/hooks/record-turn.sh waiting"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/hooks/record-turn.sh waiting"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/hooks/record-turn.sh working"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}\"/hooks/record-turn.sh turn_ended"
          }
        ]
      }
    ]
  }
}
